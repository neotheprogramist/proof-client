+impl<SC: StarkGenericConfig, Comm> CommonDataTargets<SC, Comm> {
+    /// The exact key targets consumed by this recursive verifier. Callers must bind them
+    /// to independently trusted authority, directly or through a checked family relation.
+    pub fn preprocessed_commitment(&self) -> Option<&Comm> {
+        self.preprocessed.as_ref().map(|preprocessed| &preprocessed.commitment)
+    }
+}
+
+impl<SC, Comm> CommonDataTargets<SC, Comm>
+where
+    SC: StarkGenericConfig,
+    Comm: crate::prepared::ConstrainConstantCommitment<SC::Challenge,
+        Input = <SC::Pcs as Pcs<SC::Challenge, SC::Challenger>>::Commitment>,
+{
+    /// Bind the complete preprocessing commitment to independently retained verifier authority.
+    pub fn constrain_preprocessing(
+        &self,
+        circuit: &mut CircuitBuilder<SC::Challenge>,
+        expected: &CommonData<SC>,
+    ) -> Result<(), crate::verifier::VerificationError> {
+        match (&self.preprocessed, &expected.preprocessed) {
+            (None, None) => Ok(()),
+            (Some(target), Some(expected)) => target.commitment.constrain_constant(circuit, &expected.commitment),
+            _ => Err(crate::verifier::VerificationError::InvalidProofShape(
+                "trusted preprocessing presence mismatch".into(),
+            )),
+        }
+    }
+}
+
