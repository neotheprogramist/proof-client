{
  "name": "proof-client",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "fmt:check": "oxfmt --check README.md AGENTS.md package.json package-lock.json jsconfig.json tests extension crates examples vendor/README.md vendor/sources.json",
    "lint": "oxlint --deny-warnings extension tests",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.3",
    "jsdom": "30.1.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  }
}
