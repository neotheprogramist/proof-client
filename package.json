{
  "name": "proof-client",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "fmt:check": "oxfmt --check README.md AGENTS.md package.json package-lock.json jsconfig.json stryker.config.json tests extension crates examples vendor/README.md vendor/sources.json",
    "lint": "oxlint --deny-warnings extension tests",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@types/chrome": "^0.3.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.3",
    "fast-check": "^4.10.2",
    "jsdom": "30.1.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2"
  }
}
